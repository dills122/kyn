{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "kyn",
          "informationUri": "https://github.com/",
          "rules": [
            {
              "id": "handler-tests-sync",
              "shortDescription": {
                "text": "Handler or service changed but its test file did not."
              },
              "fullDescription": {
                "text": "Handler or service changed but its test file did not."
              },
              "properties": {
                "familyId": "order-handler"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "handler-tests-sync",
          "level": "error",
          "message": {
            "text": "Handler or service changed but its test file did not. (family instance: internal/order/order)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/order/order_handler.go"
                }
              },
              "message": {
                "text": "changed file"
              }
            }
          ],
          "relatedLocations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/order/order_handler_test.go"
                }
              },
              "message": {
                "text": "expected related file"
              }
            }
          ],
          "properties": {
            "expectedFiles": [
              "internal/order/order_handler_test.go"
            ],
            "familyId": "order-handler",
            "familyName": "internal/order/order",
            "severity": "error",
            "status": "fail"
          }
        }
      ]
    }
  ]
}
